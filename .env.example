# 이 파일을 복사해서 .env.local 이라는 이름으로 저장한 뒤, 발급받은 키를 넣으세요.
# .env.local 은 깃허브에 올라가지 않아요 (키가 새지 않도록).
# 키가 비어 있으면 그 기능은 샘플 데이터로 보여줘요.
# (채용공고 비교는 키 없이 자동 수집돼요 → README 4번)

# 공공데이터포털 "소상공인시장진흥공단_상가(상권)정보" 일반 인증키 (Decoding) (상권 확인)
SEMAS_API_KEY=

# 카카오 지도 JavaScript 키 (상권 확인 → 지도). 브라우저에 공개되는 키예요.
NEXT_PUBLIC_KAKAO_MAP_KEY=
